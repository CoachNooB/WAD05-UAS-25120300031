# Leave DATABASE_URL empty to run the local-only demo.
# For TiDB use the TLS-enabled MySQL connection string provided by your cluster.
DATABASE_URL=
# Enable fictional payment details and the published demo accounts with TiDB/Supabase.
# Hosted demos still require DATABASE_URL and private Supabase storage.
DEMO_MODE=false
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DELIVERY_FEE_IDR=15000
STORE_ADDRESS=
DELIVERY_SERVICE_AREA=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
SUPABASE_URL=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Only set for a disposable integration database, never production.
TEST_DATABASE_URL=

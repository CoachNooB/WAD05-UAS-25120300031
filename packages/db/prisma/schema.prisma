generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  name String @db.VarChar(100)
  email String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)
  phone String? @db.VarChar(30)
  role String @default("CUSTOMER") @db.VarChar(10)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  orders Order[]
  reviews Payment[]
  @@map("users")
}
model Category {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  name String @unique @db.VarChar(100)
  description String? @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  products Product[]
  @@map("categories")
}
model Product {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  categoryId Int @db.UnsignedInt
  sku String @unique @db.VarChar(50)
  name String @db.VarChar(150)
  description String @db.Text
  price Int
  stock Int
  imagePath String? @db.VarChar(512)
  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  category Category @relation(fields:[categoryId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  items OrderItem[]
  @@index([categoryId,isActive])
  @@map("products")
}
model Order {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  userId Int @db.UnsignedInt
  orderNumber String @unique @db.VarChar(40)
  status String @default("AWAITING_PAYMENT") @db.VarChar(30)
  fulfillmentMethod String @db.VarChar(20)
  recipientName String @db.VarChar(100)
  recipientPhone String @db.VarChar(30)
  deliveryAddress String? @db.Text
  customerNotes String? @db.Text
  subtotal Int
  deliveryFee Int
  total Int
  version Int @default(0)
  checkoutKey String @db.VarChar(64)
  checkoutHash String @db.Char(64)
  stockRestoredAt DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  items OrderItem[]
  payments Payment[]
  @@unique([userId,checkoutKey])
  @@index([userId,createdAt])
  @@index([status,createdAt])
  @@map("orders")
}
model OrderItem {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  orderId Int @db.UnsignedInt
  productId Int @db.UnsignedInt
  productName String @db.VarChar(150)
  unitPrice Int
  quantity Int
  lineTotal Int
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade,onUpdate:Restrict)
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([orderId,productId])
  @@map("order_items")
}
model Payment {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  orderId Int @db.UnsignedInt
  reviewedBy Int? @db.UnsignedInt
  amount Int
  proofPath String @db.VarChar(512)
  proofSha256 String @db.Char(64)
  submissionKey String @db.VarChar(64)
  status String @default("PENDING_REVIEW") @db.VarChar(20)
  rejectionReason String? @db.Text
  submittedAt DateTime @default(now()) @db.DateTime(3)
  reviewedAt DateTime? @db.DateTime(3)
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  reviewer User? @relation(fields:[reviewedBy],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([orderId,submissionKey])
  @@index([orderId,status])
  @@index([status,submittedAt])
  @@map("payments")
}
model Session {
  sid String @id @db.VarChar(128)
  data String @db.LongText
  expiresAt DateTime @db.DateTime(3)
  @@index([expiresAt])
  @@map("sessions")
}
model AuthRateLimit {
  keyHash String @id @db.Char(64)
  attempts Int
  expiresAt DateTime @db.DateTime(3)
  @@index([expiresAt])
  @@map("auth_rate_limits")
}
model StorageCleanup {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  path String @db.VarChar(512)
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@map("storage_cleanup")
}
